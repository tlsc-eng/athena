// Athena keyboard shortcuts. One without "when" replaces Athena's bindings on its keys.
// "when" limits one to a context such as "Editor" or "Terminal", where it wins over Athena's
// unless theirs names a context nested inside it. "-command" removes a default.
// {"key": "cmd-k cmd-t", "command": "athena::NewTerminal"},
// {"key": "cmd-d", "command": "-athena::SplitRight"},
// {"key": "f5", "command": "athena::ShowProblems", "when": "Editor"},
// {"key": "alt-f3", "command": "editor::ShowNextChange", "when": "Editor"},
// {"key": "shift-alt-f3", "command": "editor::ShowPreviousChange", "when": "Editor"}
[
]
