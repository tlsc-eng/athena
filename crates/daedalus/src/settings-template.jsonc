// Athena settings. Comments and trailing commas are allowed, as in VS Code. A setting left out
// keeps its default, or the choice last made from the command palette or the File menu.
// Uncomment and edit any of these; Athena applies them as soon as the file is saved.
// A project's own .athena/settings.json (and the keys Athena knows in .vscode/settings.json)
// is laid over this file for its files; its "lsp" entries apply once the project is allowed.
{
  // "editor": {
  //   "format_on_save": true,          // ⌘S formats through the language server first
  //   "trim_trailing_whitespace": true,
  //   "insert_final_newline": true,
  //   "word_wrap": false,              // for tabs that have not chosen with ⌥Z
  //   "font_size": 13,
  //   "tab_size": 4,                   // for files whose indentation cannot be detected
  //   "autosave_delay_ms": 1000,       // 0 turns auto save off
  //   "inlay_hints": true,             // off hides them; on also turns on a curated set
  //   "bracket_pair_colorization": true, // colour brackets by nesting depth
  //   "lightbulb": "quickfix",         // "all" adds refactorings, "off" hides it; ⌘. lists both
  //   "linked_editing": true,          // typing in a JSX tag name renames its closing tag
  //   "minimap": false,                // hides the file overview at the editor's right edge
  //   "semanticHighlighting.enabled": false, // colours from the language server, on by default
  //   "codeLens": false,               // hides "run go generate", reference counts and the like
  //   "codeActionsOnSave": { "source.organizeImports": "explicit" } // ⌘S organizes imports
  // },
  // // Built in, as in VS Code: Markdown wraps and keeps trailing blanks, Go formats on save.
  // // These beat the "editor" block above, and a language block like this one beats them.
  // "[markdown]": { "trim_trailing_whitespace": true },
  // "theme": "system",                 // "system", "light" or "dark"
  // "ide_integration": false,          // Claude Code connects to Athena as its IDE
  // "git": { "autofetch": true },      // fetch the active project every three minutes
  // "git.worktree_dir": "~/worktrees", // new worktrees go here, not beside their repository
  // "explorer": { "confirmDragAndDrop": false }, // move tree entries without asking
  // "explorer.excludeGitIgnore": true, // hide git-ignored entries rather than dim them
  // "window": { "zoom_level": 1 },     // interface size in 10% steps, from -3 to 5
  // "eslint": { "fixOnSave": true },   // ⌘S applies ESLint's fixes; needs the project's server
  // // "hooks": false keeps Athena's hooks out of Claude Code's settings.json, and its tabs
  // // without exact running / needs input / done states.
  // "claude": { "hooks": false },
  // // The title bar's plan usage shows this profile for projects under each folder ("tlsc" is
  // // ~/.claude-tlsc; the deepest folder wins), else the profile of the project's newest session.
  // "claude.profiles": { "~/code/ai": "ai", "~/code": "tlsc" },
  // "lsp": {
  //   // Sent to each server as it starts and whenever this file changes.
  //   // gopls runs with GOTOOLCHAIN=local unless its "env" names another toolchain.
  //   "gopls": { "hints": { "parameterNames": true }, "staticcheck": true, "env": { "GOTOOLCHAIN": "auto" } },
  //   "typescript-language-server": {
  //     "preferences": { "includeInlayParameterNameHints": "all" },
  //     "typescript": { "referencesCodeLens": { "enabled": true } } // "N references" lenses
  //   }
  // },
}
