# Daedalus shell integration. Marks prompts and commands with OSC 133 so Daedalus can tell when a long
# command finishes. Set DAEDALUS_SHELL_INTEGRATION=0 in the environment to turn it off.
if [[ -n "${DAEDALUS_ORIG_ZDOTDIR+x}" ]]; then
  ZDOTDIR="$DAEDALUS_ORIG_ZDOTDIR"
  unset DAEDALUS_ORIG_ZDOTDIR
else
  unset ZDOTDIR
fi
[[ -f "${ZDOTDIR:-$HOME}/.zshenv" ]] && builtin source "${ZDOTDIR:-$HOME}/.zshenv"

if [[ -o interactive ]]; then
  _daedalus_preexec() {
    _daedalus_ran=1
    builtin printf '\e]133;C;%s\a' "$(builtin print -rn -- "${1[1,200]}" | /usr/bin/base64)"
  }
  _daedalus_precmd() {
    local ret=$?
    if (( ${_daedalus_ran:-0} )); then
      builtin printf '\e]133;D;%d\a' "$ret"
      _daedalus_ran=0
    fi
    builtin printf '\e]133;A\a'
  }
  # First in line, so $? is the command's status and not another hook's.
  precmd_functions=(_daedalus_precmd $precmd_functions)
  preexec_functions=(_daedalus_preexec $preexec_functions)
fi
